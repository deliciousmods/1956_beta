guiTypes = {

	containerWindowType = {
		name = "chi_kmt_influence_ui_window"
		orientation = lower_left
		position = { x = 0 y = 0 }
		size = { width = 620 height = 670 }
		clipping = no

		#BACKGROUND
		background = {
			name = "chi_influence_background"
			quadTextureSprite="GFX_chi_faction_influence_decor_bg"
