		}

		#TITLE
		instantTextBoxType = {
			name ="CHI_faction_influence_title_name"
			orientation = center_up
			position = { x = -280 y = 20 }
			font = "hoi_36header"
			context_aware_text = "CHI_faction_influence_title_text"
			format = center
			maxWidth = 600
		}


		########################
		### LEADER PORTRAIT ###
		########################

